{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "resources",
    "outDir": "resources/generated",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["resources/*.ts", "resources/*.mjs", "resources/gpui.d.ts"]
}
